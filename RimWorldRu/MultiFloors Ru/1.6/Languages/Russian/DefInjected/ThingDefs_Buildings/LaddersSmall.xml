<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="MF_StairEntranceBase">
		<defName>MF_LadderSUpA</defName>
		<label>маленькая лестница вверх</label>
		<description>Компактный вход на верхний уровень. Требуется крытое помещение не менее 25 клеток. Нельзя строить под землей или в одной комнате с другими лестницами вверх.</description>
		<rotatable>false</rotatable>
		<size>(1, 1)</size>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>25</costStuffCount>
		<statBases>
      		<WorkToBuild>1000</WorkToBuild>
    	</statBases>
		<uiOrder>3010</uiOrder>
		<uiIconScale>0.9</uiIconScale>
		<uiIconOffset>(0, 0.12)</uiIconOffset>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Buildings/LadderSmall/LadderSUp</texPath>
			<drawSize>(2, 2)</drawSize>
			<drawOffset>(0, 0, 0.55)</drawOffset>
		</graphicData>
		<modExtensions>
			<li Class="MultiFloors.StairsModExtension">
				<isUpstairs>true</isUpstairs>
				<connectedToExitDef>MF_LadderSExitA</connectedToExitDef>
			</li>
		</modExtensions>
	</ThingDef>
	<ThingDef ParentName="MF_StairEntranceBase">
		<defName>MF_LadderSDownA</defName>
		<label>маленькая лестница вниз</label>
		<description>Компактный вход на нижний уровень. Требуется помещение не менее 25 клеток. Нельзя строить на верхних уровнях или в одной комнате с другими лестницами вниз.</description>
		<rotatable>false</rotatable>
		<size>(1, 1)</size>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>25</costStuffCount>
		<statBases>
      		<WorkToBuild>1000</WorkToBuild>
    	</statBases>
		<uiOrder>3010</uiOrder>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Buildings/LadderSmall/LadderSDown</texPath>
			<drawSize>(2, 2)</drawSize>
		</graphicData>
		<modExtensions>
			<li Class="MultiFloors.StairsModExtension">
				<isUpstairs>false</isUpstairs>
				<connectedToExitDef>MF_LadderSExitA</connectedToExitDef>
			</li>
		</modExtensions>
	</ThingDef>
	<ThingDef ParentName="MF_StairExitBase">
		<defName>MF_LadderSExitA</defName>
		<label>выход маленькой лестницы</label>
		<description>Конечная точка маленькой лестницы.</description>
		<rotatable>false</rotatable>
		<size>(1, 1)</size>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>25</costStuffCount>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Buildings/LadderSmall/LadderSUp</texPath>
			<drawSize>(2, 2)</drawSize>
		</graphicData>
		<modExtensions>
			<li Class="MultiFloors.StairsModExtension">
				<upstairsEntranceDef>MF_LadderSUpA</upstairsEntranceDef>
				<downstairsEntranceDef>MF_LadderSDownA</downstairsEntranceDef>
			</li>
		</modExtensions>
	</ThingDef>
</Defs>